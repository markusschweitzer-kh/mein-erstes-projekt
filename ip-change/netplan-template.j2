# Network configuration generated by Ansible
# Generated on {{ ansible_date_time.iso8601 }}
# Hostname: {{ host_config['Hostname-neu'] }}

network:
  version: 2
  renderer: networkd
  ethernets:
{% if same_interface %}
    # Beide IPs auf demselben Interface
    {{ primary_interface }}:
      addresses:
        - {{ primary_ip }}/{{ prefix }}
        - {{ secondary_ip }}/{{ prefix }}
      routes:
        - to: default
          via: {{ gateway }}
      nameservers:
        addresses:
          - 8.8.8.8
          - 8.8.4.4
{% else %}
    # Primäres Interface (9.x Netzwerk)
    {{ primary_interface }}:
      addresses:
        - {{ primary_ip }}/{{ prefix }}
      routes:
        - to: default
          via: {{ gateway }}
      nameservers:
        addresses:
          - 8.8.8.8
          - 8.8.4.4
    
    # Sekundäres Interface (10.x Netzwerk)
    {{ secondary_interface }}:
      addresses:
        - {{ secondary_ip }}/{{ prefix }}
{% endif %}