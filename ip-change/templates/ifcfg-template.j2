# Network Interface Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Device: {{ device }}

TYPE=Ethernet
BOOTPROTO=none
DEFROUTE={{ 'yes' if is_primary else 'no' }}
NAME={{ device }}
DEVICE={{ device }}
ONBOOT=yes
IPADDR={{ ipaddr }}
NETMASK={{ netmask }}
{% if gateway %}
GATEWAY={{ gateway }}
{% endif %}
DNS1=8.8.8.8
DNS2=8.8.4.4